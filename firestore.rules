rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Union Hall roster: anyone can read; each phone can only write its own card.
    match /members/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'year', 'stars', 'joined', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 24
        && request.resource.data.year is int
        && request.resource.data.year >= 1
        && request.resource.data.year <= 5
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 200;
      allow delete: if false;
    }

    // Hall news: anyone can read; signed-in players can add short posts under their own ID.
    match /news/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 120
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
